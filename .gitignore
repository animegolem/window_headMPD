node_modules/
dist/
src-tauri/target/
src-tauri/gen/
.DS_Store

# Skin art is Microsoft's: generated locally from your own Headspace.wmz
# by `npm run skin`, never committed.
public/skin/
src-tauri/icons/
*.mp4

# Test skin corpus: other people's art, never committed.
skins/
# The corpus as a symlink (an engine worktree points it at the main checkout's skins/);
# `skins/` above only matches a directory.
/skins

# skinlab writes goldens and run output under ~/Library/Caches/window_headmpd/; these catch a
# stray local output directory so art can never be staged by `git add -A`.
.skinlab/
tests/**/__out__/
